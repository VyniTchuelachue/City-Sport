# Where contact messages and availability requests are sent.
# Locally: copy this file to .env. On Vercel: Project > Settings > Environment Variables.
# All of these are optional on your own server, where submissions are also kept in
# server/data. On Vercel at least one destination is required, or the forms answer
# "unavailable".

# E-mail, through Resend (https://resend.com). Several recipients: separate with commas.
RESEND_API_KEY=
NOTIFY_EMAIL=
# Sender shown on the e-mail. Needs a domain verified in Resend; leave empty to use
# Resend's shared sender, which only delivers to the Resend account's own address.
NOTIFY_FROM=

# Or, and also: POST each submission as JSON to a URL (Make, Zapier, Google Apps Script…).
FORMS_WEBHOOK_URL=
